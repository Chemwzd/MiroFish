# MiroFish runtime configuration for the local Zep-compatible setup.
# Fill __PLACEHOLDER__ values before starting.

# LLM: the host's LiteLLM gateway (OpenAI-compatible)
LLM_API_KEY=__LITELLM_MASTER_KEY__
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_MODEL_NAME=__MIROFISH_MODEL__

# Local Zep-compatible service (zepshim). Any non-empty value works; it is the
# bearer token MiroFish sends to the shim.
ZEP_API_KEY=local-zepshim
MIROFISH_ZEP_BASE_URL=http://127.0.0.1:8100/api/v2

FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false

# Start small: each round drives every agent through the LLM.
OASIS_DEFAULT_MAX_ROUNDS=10
