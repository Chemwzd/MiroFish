# zepshim configuration. Fill __PLACEHOLDER__ values before starting.

# Bind to loopback only: with host networking this keeps the shim off the LAN
# while MiroFish (also host networking) still reaches it.
ZEPSHIM_HOST=127.0.0.1
ZEPSHIM_PORT=8100
ZEPSHIM_DB=/data/zepshim.sqlite3

# Extraction LLM: the host's LiteLLM gateway.
ZEPSHIM_LLM_BASE_URL=http://127.0.0.1:4000/v1
ZEPSHIM_LLM_API_KEY=__LITELLM_MASTER_KEY__
ZEPSHIM_LLM_MODEL=__ZEPSHIM_MODEL__
ZEPSHIM_LLM_WORKERS=4

# Keep the pipeline alive if a single chunk fails extraction. Set to 0 to make
# MiroFish's batch ingestion fail loudly instead (batch status becomes partial).
ZEPSHIM_FAIL_OPEN=1
